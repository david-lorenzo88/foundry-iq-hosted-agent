# Copy to .env and fill in. .env is gitignored and never leaves your machine.
# The shell scripts source this file, so any value containing spaces must be quoted.
# Every value below is discoverable with the az CLI -- see "Fresh setup" in the README.

# ---------------------------------------------------------------- Foundry project
# Portal: your project's Overview page, or:
#   az cognitiveservices account show -n <foundry-account> -g <rg> --query properties.endpoint
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<project>
FOUNDRY_PROJECT_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<rg>/providers/Microsoft.CognitiveServices/accounts/<foundry-account>/projects/<project>
# A deployed chat model in that project.
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.4

# ------------------------------------------------- Foundry IQ knowledge base (search)
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<rg>/providers/Microsoft.Search/searchServices/<search-service>
KB_NAME=<knowledge-base-name>
KB_API_VERSION=2026-08-01-preview

# ------------------------------------------------------------------- Hosted agent
FOUNDRY_HOSTED_AGENT_NAME=airbus-maintenance-agent

# Retrieval size caps. The passages returned by the knowledge base dominate the
# agent's token cost (~25 KB / ~6.5k tokens per call at these defaults).
KB_MAX_PASSAGES=12
KB_MAX_PASSAGE_CHARS=1800
# Agentic retrieval has been observed taking 47s; keep this generous.
KB_TIMEOUT_SECONDS=180

# ------------------------------------------------------ Publishing (Container Apps)
AZURE_RESOURCE_GROUP=<rg>
AZURE_LOCATION=swedencentral
ACR_NAME=<container-registry>
CONTAINERAPP_ENV=cae-airbus-agent
CONTAINERAPP_NAME=ca-airbus-agent
IMAGE_NAME=airbus-agent-ui
# Display name of the Entra app registration used for sign-in. Quote it if it has
# spaces. Defaults to "<CONTAINERAPP_NAME>-auth" when unset.
#ENTRA_APP_NAME="Airbus Maintenance Agent"

# ------------------------------------------------------------------ Local dev only
# Point the backend at a locally running agent (python agent/main.py) instead of the
# deployed one. Leave unset to use the hosted agent.
# LOCAL_AGENT_URL=http://localhost:8088
BACKEND_PORT=8000
